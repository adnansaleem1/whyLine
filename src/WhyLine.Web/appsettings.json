{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Match": {
    "Seed": 7,
    "Scenario": "press-flip",
    "Speed": 15,
    "AutoStart": true
  },
  "Speech": {
    "Enabled": true,
    "Key": "",
    "Region": "",
    "Endpoint": ""
  },
  "Telemetry": {
    "ApplicationInsightsConnectionString": "",
    "OtlpEndpoint": ""
  },
  "Agents": {
    "Mode": "Template",
    "Orchestration": "Workflow",
    "MaxVerifierRetries": 2,
    "MaxConcurrentMoments": 4,
    "AgentTimeoutSeconds": 20,
    "ScreenBudgetSeconds": 40,
    "Foundry": {
      "ProjectEndpoint": "",
      "ReasoningModel": "gpt-5.5",
      "FastModel": "gpt-5.4-mini",
      "ReasoningEffort": "Low",
      "FastReasoningEffort": "Low"
    }
  }
}
