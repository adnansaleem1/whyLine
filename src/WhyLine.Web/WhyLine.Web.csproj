<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>WhyLine.Web</RootNamespace>
    <UserSecretsId>whyline-web-7d3f</UserSecretsId>
    <!-- Set -p:WhyLineFoundry=false to build without the NuGet-based Foundry agents and Agent Framework workflow (offline mode). -->
    <WhyLineFoundry Condition="'$(WhyLineFoundry)' == ''">true</WhyLineFoundry>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WhyLineFoundry)' == 'true'">
    <DefineConstants>$(DefineConstants);WHYLINE_FOUNDRY</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WhyLine.Core\WhyLine.Core.csproj" />
    <ProjectReference Include="..\WhyLine.Agents\WhyLine.Agents.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(WhyLineFoundry)' == 'true'">
    <ProjectReference Include="..\WhyLine.Agents.Foundry\WhyLine.Agents.Foundry.csproj" />
    <ProjectReference Include="..\WhyLine.Agents.Workflows\WhyLine.Agents.Workflows.csproj" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.*" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.*" />
  </ItemGroup>
</Project>
