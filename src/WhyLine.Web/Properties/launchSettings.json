{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "WhyLine (Template agents)": {
      "commandName": "Project",
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5080",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Agents__Mode": "Template"
      }
    },
    "WhyLine (Foundry agents)": {
      "commandName": "Project",
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5080",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Agents__Mode": "Foundry"
      }
    },
    "WhyLine (Foundry agents, Entra ID)": {
      "commandName": "Project",
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5080",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Agents__Mode": "Foundry",
        "Agents__Foundry__Auth": "EntraId"
      }
    }
  }
}
