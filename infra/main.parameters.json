{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "foundryProjectEndpoint": { "value": "${FOUNDRY_PROJECT_ENDPOINT}" },
    "foundryResourceGroup": { "value": "${FOUNDRY_RESOURCE_GROUP}" },
    "reasoningModel": { "value": "${FOUNDRY_REASONING_MODEL=gpt-5.5}" },
    "fastModel": { "value": "${FOUNDRY_FAST_MODEL=gpt-5.4-mini}" },
    "webExists": { "value": "${SERVICE_WEB_RESOURCE_EXISTS=false}" }
  }
}
